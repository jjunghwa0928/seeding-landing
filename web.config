<?xml version="1.0" encoding="UTF-8"?>
<!--
  엔클루 시딩 랜딩 IIS 설정

  - 정적 파일(index.html, tool.html, assets/, llms.txt, robots.txt, sitemap.xml)은 IIS 가 그대로 서빙
  - /api/* 는 URL Rewrite + ARR 로 PM2 의 Node 서비스(localhost:3201)에 프록시
  - 사전 조건: URL Rewrite 모듈, Application Request Routing 설치 후
    서버 수준 ARR 설정에서 "Enable proxy" 체크 (README.md 참고)
-->
<configuration>
  <system.webServer>

    <!-- 기본 문서 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- 정적 파일 MIME -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>

    <!-- /api/* → Node 견적 문의 API 프록시. /api/.env 같은 경로도 정적 파일로 가지 않는다. -->
    <rewrite>
      <rules>
        <!-- http → https. Let's Encrypt 갱신 경로(/.well-known/acme-challenge)는 제외 -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^influencer\.enclu\.com$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Seeding quote API proxy" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://localhost:3201/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- 보안 응답 헤더 (정적·API 공통) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>

    <!-- 서버 정보 헤더 제거, 비밀값과 소스 폴더는 어떤 경로로도 서빙하지 않음 -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

  <!--
    미디어 폴더만 30일 캐시. assets/ 바로 아래 JS·CSS는 파일명이 그대로라 넣지 않는다.
    파일명이 내용 해시인 것은 릴스뿐이라(리뷰는 원본 URL 해시, 브랜드 로고는 이름) immutable은 쓰지 않는다.
  -->
  <location path="assets/reviews">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/reels">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/IMG">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- /api 경로에만 요청 본문 64KB 제한 (견적 문의 JSON 은 16KB 이내) -->
  <location path="api">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="65536" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
