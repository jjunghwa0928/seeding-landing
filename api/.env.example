# 시딩 견적 문의 API 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.

# 서비스 포트 (IIS ARR 가 http://localhost:3201 로 프록시. enclu-contact-api 는 3200)
PORT=3201
# production 이면 SMTP_PASS 가 비어 있을 때 기동을 거부한다.
# PM2(ecosystem.config.js)가 production 으로 고정하므로 로컬 개발에서만 development 로 바꾼다.
NODE_ENV=production

# ---- SMTP (네이버웍스) ----
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=465
# 465 포트(SMTPS)면 true, 587(STARTTLS)이면 false
SMTP_SECURE=true
SMTP_USER=mkt2@enclu.co.kr
# 네이버웍스 관리자/개인 설정에서 발급한 앱 비밀번호, 이 파일이 아닌 .env 에만 넣는다
SMTP_PASS=

# 발신자 / 수신자
# MAIL_FROM 에는 주소만 넣는다. 보낸 사람 이름(ENCLU 시딩 견적 문의)은 코드에 고정되어 있다.
# .env 에 한글 등 영문 외 글자를 넣지 않는다. 윈도우 편집기가 인코딩을 바꿔 저장하면 글자가 깨진다.
MAIL_FROM=mkt2@enclu.co.kr
MAIL_TO=mkt2@enclu.co.kr

# ---- Cloudflare Turnstile (선택) ----
# 프런트엔드 위젯이 아직 없으므로 비워 둔다. 값을 넣으면 토큰 없는 모든 문의가 거부된다.
TURNSTILE_SECRET=

# ---- AX Hub 영업 리드 전달 (선택) ----
# 허브에서 발급한 리드 키, 이 파일이 아닌 .env 에만 넣는다. 비우면 허브로 보내지 않고 메일만 보낸다.
AXHUB_LEAD_KEY=
# 비워 둔다. 기본값 https://axhub.enclu.com/api/sales/leads 만 허용하고, 다른 주소를 넣으면 전달을 끄고 기동 때 경고한다.
AXHUB_LEADS_URL=

# ---- CORS ----
# 다른 도메인에서 호출을 허용할 때만 콤마로 나열. 비우면 same-origin 만 허용.
ALLOWED_ORIGINS=
